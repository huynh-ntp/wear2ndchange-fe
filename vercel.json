{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://45.119.82.37:8080/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "wear2ndchance.vercel.app"
        }
      ]
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://45.119.82.37:8080/uploads/:path*",
      "has": [
        {
          "type": "host",
          "value": "wear2ndchance.vercel.app"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ]
    }
  ]
}
